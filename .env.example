# WhatsApp Notification Configuration
# Destination number (International format without '+' sign)
WHATSAPP_PHONE=923258454946

# OPTION 1: CallMeBot API (Easiest & 100% Free for self-alerts)
# 1. Save "+34 644 44 49 61" (CallMeBot) in your WhatsApp contacts
# 2. Send this exact message to it from +923258454946 on WhatsApp:
#    "I allow callmebot to send me messages"
# 3. CallMeBot will reply with your API key. Paste it here:
CALLMEBOT_API_KEY=

# OPTION 2: Twilio WhatsApp API (Optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=+14155238886

# Server Port
PORT=5000
